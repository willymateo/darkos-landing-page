# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# Inbox that receives "Plan your platform" inquiries. Comma-separate for several.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "DarkOS AI <hello@yourdomain.com>".
# Leave empty to use Resend's test sender (only delivers to your Resend account's own email).
RESEND_FROM_EMAIL=
